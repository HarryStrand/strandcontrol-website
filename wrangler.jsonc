{
	// Must match the Worker name in the Cloudflare dashboard.
	"name": "strandcontrol-website",
	"main": "src/index.js",
	// Kept aligned with the production assets config from main.
	"compatibility_date": "2026-10-21",
	"assets": {
		// Static site lives at the repo root. No build step.
		"directory": "./",
		"binding": "ASSETS",
		// Every request runs the Worker so HTML can be translated from Accept-Language,
		// including the 404 page. CSS, images, and scripts are returned unchanged.
		// /support still gets the Turnstile site key stamped onto the form.
		"run_worker_first": true,
		// Unmatched paths return 404.html with status 404.
		"not_found_handling": "404-page",
		// /dartopia/ (and /privacy/, /support/) serve that folder's index.html.
		// Requests without the trailing slash redirect to the slash form.
		"html_handling": "auto-trailing-slash"
	},
	// Public Turnstile site key. The Worker copies this onto the support form.
	// Not a secret. Local wrangler dev can override it from .dev.vars.
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFvu9R7-bXM_yPjL",
		// Web3Forms file uploads require the Pro plan. There is no API to ask
		// the access key which plan it is on, so this switch shows the file field.
		"SUPPORT_ATTACHMENTS": "false"
	},
	// Thank-you mail after a support message is accepted.
	// The sender must match SUPPORT_FROM_EMAIL in src/index.js.
	// strandcontrol.com has to be onboarded for Email Sending before this delivers.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["support@strandcontrol.com"]
		}
	],
	// Per-IP limit for POST /api/support. namespace_id must be unique in the account.
	// The window is 60 seconds; that is the longest period this binding allows.
	"ratelimits": [
		{
			"name": "SUPPORT_RATE_LIMITER",
			"namespace_id": "87021",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	}
}
